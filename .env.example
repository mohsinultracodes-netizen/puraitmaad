# Public site origin only. Never place secrets in public configuration.
# Optional: the centralized brand configuration supplies this production fallback.
SITE_URL=https://puraitmaad.com

# Server-only email credential. Set this in .env.local and GoDaddy's server environment.
# Never prefix it with NEXT_PUBLIC_. This example intentionally contains no key.
RESEND_API_KEY=

# Server-only sender (use your verified sender/domain) and private recipient.
# Configure both in GoDaddy BEFORE deploying Phase 4. Never use NEXT_PUBLIC_.
RESEND_FROM=
RESEND_TO=
